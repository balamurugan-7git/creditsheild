# CrediShield AI Backend Environment Configuration

APP_ENV=development
SECRET_KEY=dev-secret-change-in-production-must-be-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (MySQL)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/credishield

# Fallback SQLite connection string (for offline testing)
# DATABASE_URL=sqlite:///./credishield.db

CORS_ORIGINS=http://localhost:5173,https://credishield-web.onrender.com
RATE_LIMIT=60/minute

MODEL_PATH=../ml/artifacts/model_v1.joblib
MODEL_META_PATH=../ml/artifacts/model_v1_meta.json
POLICY_PATH=./policy/thresholds.json
